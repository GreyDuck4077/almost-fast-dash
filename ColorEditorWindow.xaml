<Window x:Class="DV5Direct.ColorEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="470" Height="350" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#0B1422" Foreground="White" FontFamily="Segoe UI" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#173344"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ColorRow" TargetType="Border"><Setter Property="Background" Value="#101B2B"/><Setter Property="BorderBrush" Value="#2A3B50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    </Window.Resources>
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Each stage uses the standard Windows color selector." Foreground="#8B9EB5" Margin="0,5,0,18"/></StackPanel>
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource ColorRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="LowSwatch" Width="38" Height="38" CornerRadius="9"/><StackPanel Grid.Column="1" Margin="13,0"><TextBlock Text="LOW" Foreground="#8B9EB5" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="LowValue" FontSize="15" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="CHOOSE COLOR" Click="Low_Click"/></Grid></Border>
            <Border x:Name="MiddleRow" Style="{StaticResource ColorRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="MiddleSwatch" Width="38" Height="38" CornerRadius="9"/><StackPanel Grid.Column="1" Margin="13,0"><TextBlock Text="MIDDLE" Foreground="#8B9EB5" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="MiddleValue" FontSize="15" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="CHOOSE COLOR" Click="Middle_Click"/></Grid></Border>
            <Border x:Name="HighRow" Style="{StaticResource ColorRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="HighSwatch" Width="38" Height="38" CornerRadius="9"/><StackPanel Grid.Column="1" Margin="13,0"><TextBlock Text="HIGH" Foreground="#8B9EB5" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="HighValue" FontSize="15" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="CHOOSE COLOR" Click="High_Click"/></Grid></Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="CANCEL" Background="#24364B" Margin="0,0,10,0" Click="Cancel_Click"/><Button Content="SAVE COLORS" Background="#1E96A3" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
