root = true

# One style for every file: four spaces, Windows line endings, UTF-8.
[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Code tidiness the editor flags as you type (and a build with -p:EnforceCodeStyleInBuild=true reports):
# usings, members, parameters and assignments nothing uses, and fields that are never reassigned.
[*.cs]
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
