<Window x:Class="AlmostFastOverlays.DesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard designer" Width="1560" Height="940" MinWidth="1240" MinHeight="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13" Foreground="{StaticResource Brush.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- The ƒx switch beside each property -->
        <Style x:Key="Fx" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSubtle}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A tool on the left rail (one at a time), and the rail's panel switch -->
        <Style x:Key="RailTool" TargetType="RadioButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSubtle}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A tool's icon: drawn lines in the tool's colour -->
        <Style x:Key="RailIcon" TargetType="Path">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource T.Overline}">
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition x:Name="LibraryColumn" Width="272"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Toolbar ================= -->
        <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Background="{StaticResource Brush.Sidebar}">
            <DockPanel Margin="14,0,14,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2DD4BF"/>
                                <GradientStop Color="#3B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE790;" FontSize="14" Foreground="#04221E" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" MinWidth="120">
                        <TextBlock x:Name="TitleText" Text="Dashboard" FontWeight="SemiBold"/>
                        <TextBlock Text="Screen designer" Style="{StaticResource T.Caption}" FontSize="12"/>
                    </StackPanel>
                    <Border Width="1" Height="26" Background="{StaticResource Brush.Border}" Margin="16,0,12,0"/>
                    <Button x:Name="UndoButton" Style="{StaticResource Tool}" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click">
                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE7A7;"/>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource Tool}" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click">
                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE7A6;"/>
                    </Button>
                    <Border Width="1" Height="26" Background="{StaticResource Brush.Border}" Margin="12,0"/>
                    <TextBlock Text="Screen" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ScreenCombo" Width="170" VerticalAlignment="Center" SelectionChanged="ScreenCombo_SelectionChanged"/>
                    <Button Style="{StaticResource Tool}" ToolTip="Screen options: add, rename, show-when condition, delete" Click="ScreenMenu_Click" Margin="4,0,0,0">
                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE712;"/>
                    </Button>
                    <Border Width="1" Height="26" Background="{StaticResource Brush.Border}" Margin="12,0"/>
                    <TextBlock Text="Preview" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PreviewCombo" Width="170" VerticalAlignment="Center" SelectionChanged="PreviewCombo_SelectionChanged"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                                ToolTip="Changes save as you go, and a running dashboard picks them up within a second">
                        <TextBlock x:Name="SaveStateIcon" Style="{StaticResource T.Icon}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource Brush.Success}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SaveState" Style="{StaticResource T.Caption}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource Tool}" ToolTip="Formula reference: every field and function ƒx can use, with examples (F1)" Click="FormulaReference_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE82D;" Margin="0,0,6,0"/>
                            <TextBlock Text="Formulas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tool}" ToolTip="Import a design file (.afodash)" Click="Import_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE8B5;" Margin="0,0,6,0"/>
                            <TextBlock Text="Import" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Tool}" ToolTip="Export this design to share it (.afodash)" Click="Export_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xEDE1;" Margin="0,0,6,0"/>
                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Left: the tool rail ================= -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                <RadioButton x:Name="ToolMove" Style="{StaticResource RailTool}" GroupName="Tools" Tag="Move" IsChecked="True" Checked="Tool_Checked"
                             ToolTip="Move: select, move and resize (V)">
                    <Path Style="{StaticResource RailIcon}" Data="M5,2.5 L5,16.5 L8.6,13.2 L11,18 L13.2,17 L10.9,12.2 L15.6,12.2 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" StrokeThickness="0.8"/>
                </RadioButton>
                <RadioButton x:Name="ToolRectangle" Style="{StaticResource RailTool}" GroupName="Tools" Tag="Rectangle" Checked="Tool_Checked"
                             ToolTip="Rectangle: drag to draw one; Shift for a square (U, Shift+U for the next shape)">
                    <Path Style="{StaticResource RailIcon}" Data="M3.5,5.5 H16.5 V14.5 H3.5 Z"/>
                </RadioButton>
                <RadioButton x:Name="ToolEllipse" Style="{StaticResource RailTool}" GroupName="Tools" Tag="Ellipse" Checked="Tool_Checked"
                             ToolTip="Ellipse: drag to draw one; Shift for a circle (Shift+U)">
                    <Path Style="{StaticResource RailIcon}" Data="M10,4.5 A6.5,5.5 0 1 1 9.99,4.5 Z"/>
                </RadioButton>
                <RadioButton x:Name="ToolPolygon" Style="{StaticResource RailTool}" GroupName="Tools" Tag="Polygon" Checked="Tool_Checked"
                             ToolTip="Polygon: drag to draw one, then set its sides or make it a star in Properties (Shift+U)">
                    <Path Style="{StaticResource RailIcon}" Data="M10,3 L16.1,6.5 L16.1,13.5 L10,17 L3.9,13.5 L3.9,6.5 Z"/>
                </RadioButton>
                <RadioButton x:Name="ToolLine" Style="{StaticResource RailTool}" GroupName="Tools" Tag="Line" Checked="Tool_Checked"
                             ToolTip="Line: drag to draw one; Shift keeps it straight or at 45° (Shift+U)">
                    <Path Style="{StaticResource RailIcon}" Data="M4,16 L16,4"/>
                </RadioButton>
                <RadioButton x:Name="ToolPen" Style="{StaticResource RailTool}" GroupName="Tools" Tag="Pen" Checked="Tool_Checked"
                             ToolTip="Pen: click for corners, drag for curves; click the first point to close (P)">
                    <Path Style="{StaticResource RailIcon}" Data="M4,16.5 L5.6,11 L12.8,3.8 L16.2,7.2 L9,14.4 Z M5.6,11 L9,14.4 M4,16.5 L7.4,13.1"/>
                </RadioButton>
                <RadioButton x:Name="ToolText" Style="{StaticResource RailTool}" GroupName="Tools" Tag="Text" Checked="Tool_Checked"
                             ToolTip="Text: click or drag where it goes, then type (T)">
                    <Path Style="{StaticResource RailIcon}" Data="M4.5,4.5 H15.5 M10,4.5 V16 M8,16 H12" StrokeThickness="1.8"/>
                </RadioButton>
                <Border Width="24" Height="1" Background="{StaticResource Brush.Border}" Margin="0,4,0,8"/>
                <RadioButton x:Name="ToolHand" Style="{StaticResource RailTool}" GroupName="Tools" Tag="Hand" Checked="Tool_Checked"
                             ToolTip="Hand: drag to move around the canvas (H, or hold Space)">
                    <Path Style="{StaticResource RailIcon}" Data="M10,2.5 V17.5 M2.5,10 H17.5 M10,2.5 L8,4.5 M10,2.5 L12,4.5 M10,17.5 L8,15.5 M10,17.5 L12,15.5 M2.5,10 L4.5,8 M2.5,10 L4.5,12 M17.5,10 L15.5,8 M17.5,10 L15.5,12"/>
                </RadioButton>
                <RadioButton x:Name="ToolZoom" Style="{StaticResource RailTool}" GroupName="Tools" Tag="Zoom" Checked="Tool_Checked"
                             ToolTip="Zoom: click to zoom in, Alt+click to zoom out (Z)">
                    <Path Style="{StaticResource RailIcon}" Data="M8.5,3.5 A5,5 0 1 1 8.49,3.5 Z M12.3,12.3 L16.5,16.5 M6.5,8.5 H10.5 M8.5,6.5 V10.5"/>
                </RadioButton>
                <Border Width="24" Height="1" Background="{StaticResource Brush.Border}" Margin="0,4,0,8"/>
                <ToggleButton x:Name="LibraryToggle" Style="{StaticResource RailToggle}" IsChecked="True" Click="LibraryToggle_Click"
                              ToolTip="Library: every widget, quick value and block, to drag onto the canvas">
                    <Path Style="{StaticResource RailIcon}" Data="M3.5,3.5 H8.5 V8.5 H3.5 Z M11.5,3.5 H16.5 V8.5 H11.5 Z M3.5,11.5 H8.5 V16.5 H3.5 Z M11.5,11.5 H16.5 V16.5 H11.5 Z"/>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- ================= Library: widgets, quick values and blocks ================= -->
        <Border x:Name="LibraryPanel" Grid.Row="1" Grid.Column="1" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,12,8,2" LastChildFill="False">
                    <TextBlock Text="LIBRARY" Style="{StaticResource T.Overline}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Tool}" ToolTip="Hide the library (the grid button on the left brings it back)" Click="LibraryHide_Click">
                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE76B;" FontSize="11"/>
                    </Button>
                </DockPanel>
                <ScrollViewer x:Name="WidgetsPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Toolbox" Margin="14,0,14,16"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <!-- ================= Center: canvas ================= -->
        <Grid Grid.Row="1" Grid.Column="2" Background="#07090C">
            <ScrollViewer x:Name="CanvasScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                          PreviewMouseWheel="CanvasScroller_PreviewMouseWheel">
                <Grid x:Name="CanvasHost" Margin="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>
                    <Border x:Name="Bezel" Width="854" Height="480" BorderBrush="#2A323E" BorderThickness="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                        </Border.Effect>
                        <Image x:Name="Frame" Width="854" Height="480" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Canvas x:Name="Overlay" Width="854" Height="480" Background="Transparent" ClipToBounds="False" AllowDrop="True" Focusable="True"
                            MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseLeftButtonUp"
                            MouseRightButtonUp="Overlay_MouseRightButtonUp" DragOver="Overlay_DragOver" Drop="Overlay_Drop"/>
                </Grid>
            </ScrollViewer>

            <!-- Floating canvas controls -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" Background="{StaticResource Brush.SurfaceRaised}"
                    BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="10" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="GridToggle" Style="{StaticResource ToolToggle}" Content="Grid" IsChecked="True" ToolTip="Show the layout grid" Click="ViewOption_Click"/>
                    <ToggleButton x:Name="SnapToggle" Style="{StaticResource ToolToggle}" Content="Snap" IsChecked="True" ToolTip="Snap to the grid, the canvas and other widgets (hold Alt to bypass)" Click="ViewOption_Click"/>
                    <ToggleButton x:Name="OutlineToggle" Style="{StaticResource ToolToggle}" Content="Outlines" ToolTip="Outline every widget" Click="ViewOption_Click"/>
                    <Border Width="1" Height="22" Background="{StaticResource Brush.Border}" Margin="4,0,8,0"/>
                    <Button Style="{StaticResource Tool}" ToolTip="Zoom out (Ctrl+wheel)" Click="ZoomOut_Click"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE71F;"/></Button>
                    <Button x:Name="ZoomLabel" Style="{StaticResource Tool}" MinWidth="58" ToolTip="Fit to window" Click="ZoomFit_Click" Content="100%"/>
                    <Button Style="{StaticResource Tool}" ToolTip="Zoom in (Ctrl+wheel)" Click="ZoomIn_Click"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE8A3;"/></Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Right: properties (or the theme) above layers, both always there ================= -->
        <Border Grid.Row="1" Grid.Column="3" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition MinHeight="160"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="LayersRow" Height="300" MinHeight="120"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Segmented}" Margin="14,12,14,4" HorizontalAlignment="Stretch">
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="TabProperties" Style="{StaticResource Segment}" MinWidth="0" Content="Properties" GroupName="RightTabs" IsChecked="True" Checked="RightTab_Checked"/>
                        <RadioButton x:Name="TabTheme" Style="{StaticResource Segment}" MinWidth="0" Content="Theme" GroupName="RightTabs" Checked="RightTab_Checked"/>
                    </UniformGrid>
                </Border>
                <ScrollViewer x:Name="InspectorScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Inspector" Margin="18,8,18,24"/>
                </ScrollViewer>
                <ScrollViewer x:Name="ThemePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="ThemeEditor" Margin="18,4,18,16"/>
                </ScrollViewer>
                <!-- Drag to give properties or layers more room -->
                <GridSplitter Grid.Row="2" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="Transparent" Cursor="SizeNS" ToolTip="Drag to resize" Focusable="False"/>
                <Border Grid.Row="2" Height="1" Background="{StaticResource Brush.Border}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                <DockPanel x:Name="LayersPanel" Grid.Row="3">
                    <DockPanel DockPanel.Dock="Top" Margin="16,8,10,4" LastChildFill="False">
                        <TextBlock Text="LAYERS" Style="{StaticResource T.Overline}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LayerCount" Style="{StaticResource T.Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,4,12,10">
                        <Button Style="{StaticResource Tool}" ToolTip="Bring forward (])" Click="Forward_Click"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE70E;"/></Button>
                        <Button Style="{StaticResource Tool}" ToolTip="Send backward ([)" Click="Backward_Click"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE70D;"/></Button>
                        <Button Style="{StaticResource Tool}" ToolTip="Group the selected layers (Ctrl+G)" Click="GroupLayers_Click"><Path Style="{StaticResource RailIcon}" Width="16" Height="16" StrokeThickness="1.3" Data="M2.5,2.5 H10.5 V10.5 H2.5 Z M5.5,5.5 H13.5 V13.5 H5.5 Z"/></Button>
                        <Button Style="{StaticResource Tool}" ToolTip="Duplicate (Ctrl+D)" Click="Duplicate_Click"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE8C8;"/></Button>
                        <Button Style="{StaticResource Tool}" ToolTip="Delete (Del)" Click="Delete_Click"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE74D;"/></Button>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LayersList" Margin="8,0,8,4"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Grid.ColumnSpan="4" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <TextBlock x:Name="CursorText" DockPanel.Dock="Right" Style="{StaticResource T.Caption}" VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource T.Caption}" VerticalAlignment="Center"
                           Text="Drag from the Library, or draw with the tools on the left. Arrows nudge, Shift+arrows nudge 10, Ctrl+D duplicates, Alt bypasses snapping."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
