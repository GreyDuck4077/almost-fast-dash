<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>DV5Direct</AssemblyName>
    <Version>2.0.0</Version>
    <RootNamespace>DV5Direct</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="SimHub.BitmapDisplay.Core">
      <HintPath>C:\Program Files (x86)\SimHub\SimHub.BitmapDisplay.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SimHub.BitmapDisplay.Vocore">
      <HintPath>C:\Program Files (x86)\SimHub\SimHub.BitmapDisplay.Vocore.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SimHub.LibUsbNative">
      <HintPath>C:\Program Files (x86)\SimHub\SimHub.LibUsbNative.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="K4os.Compression.LZ4">
      <HintPath>C:\Program Files (x86)\SimHub\K4os.Compression.LZ4.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>C:\Program Files (x86)\SimHub\Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="log4net">
      <HintPath>C:\Program Files (x86)\SimHub\log4net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SimHub.Logging">
      <HintPath>C:\Program Files (x86)\SimHub\SimHub.Logging.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="iRacingSDK">
      <HintPath>C:\Program Files (x86)\SimHub\iRacingSDK.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="YamlDotNet">
      <HintPath>C:\Program Files (x86)\SimHub\YamlDotNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="C:\Program Files (x86)\SimHub\libusb-1.0.dll">
      <Link>libusb-1.0.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
