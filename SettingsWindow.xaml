<Window x:Class="AlmostFastOverlays.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Almost Fast Dash" Width="1280" Height="840" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.Bg}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13" Foreground="{StaticResource Brush.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Two-column settings row: label and help text on the left, control on the right -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,26">
                    <Image Source="Assets/AppIcon.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Almost Fast Dash" FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Sim racing studio" Style="{StaticResource T.Caption}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Divider}" Margin="4,0,4,12"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource T.Caption}" Foreground="{StaticResource Brush.TextTertiary}" Margin="12,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavGallery" Style="{StaticResource Nav.Item}" GroupName="Nav" Checked="NavGallery_Checked" Click="NavGallery_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE8A9;" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboards" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <StackPanel x:Name="DashboardSubNav" Visibility="Collapsed" Margin="0,0,0,6"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav.Item}" GroupName="Nav" Checked="NavSettings_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE772;" Margin="0,0,12,0"/>
                            <TextBlock Text="Devices" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavApp" Style="{StaticResource Nav.Item}" GroupName="Nav" Checked="NavApp_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE713;" Margin="0,0,12,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Main ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Header: whether the dashboard is running on the wheel screen, and start, restart or stop. -->
            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid Margin="32,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusPill" Style="{StaticResource RunControl}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <StackPanel VerticalAlignment="Center" MinWidth="128">
                                <TextBlock Text="Dashboard" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="190">
                                    <Run x:Name="StatusText" Text="Checking…"/><Run x:Name="ActiveText" Foreground="{StaticResource Brush.TextTertiary}"/>
                                </TextBlock>
                            </StackPanel>
                            <Button x:Name="StopButton" Style="{StaticResource Btn.RunIcon}" Content="&#xE71A;" Click="StopDashboard_Click" Margin="8,0,0,0"
                                    ToolTip="Stop the dashboard and blank the wheel screen"/>
                            <Button x:Name="StartButton" Style="{StaticResource Btn.RunIcon}" Click="StartDashboard_Click" Margin="4,0,0,0">
                                <TextBlock x:Name="StartIcon" Style="{StaticResource T.Icon}" Text="&#xE768;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="SavedIndicator" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource Brush.Success}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="SavedText" Text="Saved" Style="{StaticResource T.Caption}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Gallery page ============ -->
            <ScrollViewer x:Name="GalleryPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,28,32,32" MaxWidth="1120">
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Dashboards" Style="{StaticResource T.PageTitle}"/>
                            <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="Choose what your wheel screen shows. The default dashboard is used unless another one is assigned to the session's track type."/>
                        </StackPanel>
                        <Button x:Name="NewDashboardButton" Grid.Column="1" VerticalAlignment="Top" Click="NewDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="New dashboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <WrapPanel x:Name="DashboardCards" SizeChanged="DashboardCards_SizeChanged"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Editor page ============ -->
            <ScrollViewer x:Name="EditorPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,28,32,32" MaxWidth="1120">
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Height="28" Padding="6,0" Margin="-6,-8,0,10" Click="BackToGallery_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE72B;" FontSize="11" Margin="0,0,8,0"/>
                            <TextBlock Text="All dashboards" FontWeight="Normal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="EditorTitle" Style="{StaticResource T.PageTitle}" Text="Velocity"/>
                                <Border x:Name="EditorDefaultBadge" Style="{StaticResource Pill}" Background="{StaticResource Brush.SuccessSubtle}" Margin="12,4,0,0">
                                    <TextBlock Text="Default" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Success}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="EditorSubtitle" Style="{StaticResource T.Secondary}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="SetDefaultButton" Content="Set as default" Margin="0,0,8,0" Click="SetDefault_Click"/>
                            <Button x:Name="MoreButton" Style="{StaticResource Btn.Icon}" Content="&#xE712;" BorderBrush="{StaticResource Brush.BorderStrong}"
                                    Background="{StaticResource Brush.SurfaceRaised}" ToolTip="More actions" Click="More_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Live preview -->
                    <Border Style="{StaticResource Card}" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <!-- The wheel screen, and the LEDs of every set-up device under it -->
                            <StackPanel Width="512">
                                <Border Width="512" Height="288" CornerRadius="10" BorderBrush="#232A35" BorderThickness="1" Background="#07090C">
                                    <Border CornerRadius="9">
                                        <Border.Background>
                                            <ImageBrush x:Name="PreviewBrush" Stretch="Uniform"/>
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel x:Name="LedStripsHost" Margin="0,16,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="28,4,0,0">
                                <TextBlock Text="LIVE PREVIEW" Style="{StaticResource T.Overline}"/>
                                <TextBlock Style="{StaticResource T.Secondary}" Margin="0,8,0,20"
                                           Text="Pick a moment in a race to see exactly how the screen and every light look in it: the shift point, a car alongside, the pit limiter, a flag. Animated lap plays through a lap; Live iRacing shows your session. Changes apply to a running dashboard within a second."/>
                                <CheckBox x:Name="MirrorLeds" Style="{StaticResource Switch}" Content="Show on my wheel" IsChecked="True" Margin="0,0,0,4"
                                          ToolTip="Shows this preview on your wheel screen and LED devices when iRacing isn't running"/>
                                <TextBlock x:Name="MirrorNote" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,0,0,18"
                                           Text="Lights your devices with this preview while the dashboard is stopped."/>
                                <TextBlock Text="Preview state" Style="{StaticResource T.Label}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="PreviewState" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="PreviewState_SelectionChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Layout design -->
                    <Border x:Name="DesignCard" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.AccentSubtle}" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE790;" FontSize="18" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="DesignCardTitle" Text="Screen layout" Style="{StaticResource T.Title}"/>
                                <TextBlock x:Name="DesignCardText" Style="{StaticResource T.Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="DesignButton" Grid.Column="2" Style="{StaticResource Btn.Primary}" VerticalAlignment="Center" Margin="16,0,0,0" Click="Design_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource T.Icon}" Text="&#xE70F;" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="DesignButtonLabel" Text="Open designer" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- General -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="General" Style="{StaticResource T.Title}"/>
                            <TextBlock Text="Name, color and when this dashboard is used." Style="{StaticResource T.Caption}" Margin="0,4,0,18"/>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Name" Style="{StaticResource T.Label}"/>
                                </StackPanel>
                                <TextBox x:Name="NameBox" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" Width="320" MaxLength="32"
                                         LostKeyboardFocus="NameBox_LostKeyboardFocus" KeyDown="NameBox_KeyDown"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Accent color" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="Panel outlines, progress and highlights." Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="AccentPresets" Orientation="Horizontal"/>
                                    <Border Width="1" Background="{StaticResource Brush.Border}" Margin="4,4,12,4"/>
                                    <Button x:Name="AccentCustom" Style="{StaticResource Swatch}" ToolTip="Pick any color" Click="AccentCustom_Click"/>
                                    <TextBlock x:Name="AccentHex" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                               Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Top" Margin="0,4,24,0">
                                    <TextBlock Text="Use automatically for" Style="{StaticResource T.Label}"/>
                                    <TextBlock x:Name="AssignmentHelp" Style="{StaticResource T.Caption}" Margin="0,3,0,0"
                                               Text="Switches to this dashboard when a session starts on these track types."/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,-8">
                                    <ToggleButton x:Name="OvalChip" Style="{StaticResource Chip}" Content="Oval" Checked="AssignmentChanged" Unchecked="AssignmentChanged"/>
                                    <ToggleButton x:Name="RoadChip" Style="{StaticResource Chip}" Content="Road" Checked="AssignmentChanged" Unchecked="AssignmentChanged"/>
                                    <ToggleButton x:Name="DirtOvalChip" Style="{StaticResource Chip}" Content="Dirt oval" Checked="AssignmentChanged" Unchecked="AssignmentChanged"/>
                                    <ToggleButton x:Name="DirtRoadChip" Style="{StaticResource Chip}" Content="Dirt road" Checked="AssignmentChanged" Unchecked="AssignmentChanged"/>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Light layers -->
                    <Border x:Name="LightsCard" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Brush.AccentSubtle}" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE781;" FontSize="18" Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LightsCardTitle" Text="Light layers" Style="{StaticResource T.Title}"/>
                                <TextBlock x:Name="LightsCardText" Style="{StaticResource T.Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="LightsButton" Style="{StaticResource Btn.Primary}" Click="Lights_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE781;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="LightsButtonLabel" Text="Open light designer" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Flag alerts -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Flag alerts" Style="{StaticResource T.Title}"/>
                            <TextBlock Text="How green and yellow flags flash across the screen before the dashboard returns." Style="{StaticResource T.Caption}" Margin="0,4,0,18"/>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Flashes" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="BlinkCountSlider" Minimum="1" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1" Width="380"/>
                                    <TextBlock x:Name="BlinkCountValue" Style="{StaticResource T.Value}" HorizontalAlignment="Left" TextAlignment="Left" Margin="18,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Flash length" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="Time each flash stays on." Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="BlinkLengthSlider" Minimum="50" Maximum="1000" IsSnapToTickEnabled="True" TickFrequency="10" Width="380"/>
                                    <TextBlock x:Name="BlinkLengthValue" Style="{StaticResource T.Value}" HorizontalAlignment="Left" TextAlignment="Left" Margin="18,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Hold afterwards" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="Keep the flag on screen after flashing." Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="HoldSlider" Minimum="0" Maximum="10000" IsSnapToTickEnabled="True" TickFrequency="250" Width="380"/>
                                    <TextBlock x:Name="HoldValue" Style="{StaticResource T.Value}" HorizontalAlignment="Left" TextAlignment="Left" Margin="18,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="{StaticResource Brush.SurfaceRaised}" CornerRadius="8" Padding="12,9" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource T.Icon}" Text="&#xE7C1;" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="AlertSummary" Style="{StaticResource T.Caption}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Manage -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Manage" Style="{StaticResource T.Title}"/>
                            <TextBlock x:Name="ManageHelp" Style="{StaticResource T.Caption}" Margin="0,4,0,18"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="DuplicateButton" Margin="0,0,8,0" Click="Duplicate_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE8C8;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Duplicate" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ResetButton" Margin="0,0,8,0" Click="Reset_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE777;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="ResetLabel" Text="Reset to defaults" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DeleteButton" Style="{StaticResource Btn.Danger}" Click="Delete_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="DeleteLabel" Text="Delete dashboard" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ Device & app page ============ -->
            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,28,32,32" MaxWidth="1120">
                    <TextBlock Text="Devices" Style="{StaticResource T.PageTitle}"/>
                    <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,24"
                               Text="Your wheel screen and every LED device. Set a device up once and every dashboard's lights use it."/>

                    <!-- LED devices: everything with LEDs, each set up with the device wizard -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="LED devices" Style="{StaticResource T.Title}"/>
                                    <TextBlock Style="{StaticResource T.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left"
                                               Text="The LEDs on your wheel screen, light bars, Arduino boards, Adalight strips and WLED controllers. Add one, describe its shape and show the app where its LEDs are; every dashboard's lights then use it."/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" VerticalAlignment="Top" Click="AddDevice_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Add device" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="DevicesStatus" Style="{StaticResource T.Caption}" Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <StackPanel x:Name="DevicesHost"/>
                        </StackPanel>
                    </Border>

                    <!-- The wheel screen -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Wheel screen" Style="{StaticResource T.Title}"/>
                            <TextBlock Text="The screen on your wheel. It can be driven by only one program at a time, so close other dashboard software while this runs." Style="{StaticResource T.Caption}" Margin="0,4,0,18"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Screen brightness" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="Backlight level of the screen." Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="ScreenBrightness" Minimum="10" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" Width="380"/>
                                    <TextBlock x:Name="ScreenBrightnessValue" Style="{StaticResource T.Value}" HorizontalAlignment="Left" TextAlignment="Left" Margin="18,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ App settings page ============ -->
            <ScrollViewer x:Name="AppPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,28,32,32" MaxWidth="1120">
                    <TextBlock Text="Settings" Style="{StaticResource T.PageTitle}"/>
                    <TextBlock Style="{StaticResource T.Secondary}" Margin="0,6,0,24"
                               Text="Units, startup and how Almost Fast Dash runs. These apply everywhere."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Units" Style="{StaticResource T.Title}"/>
                            <TextBlock Text="Used by every dashboard." Style="{StaticResource T.Caption}" Margin="0,4,0,18"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Speed" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Style="{StaticResource Segmented}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SpeedMph" Style="{StaticResource Segment}" GroupName="Speed" Content="MPH" Checked="Units_Changed"/>
                                        <RadioButton x:Name="SpeedKph" Style="{StaticResource Segment}" GroupName="Speed" Content="km/h" Checked="Units_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Fuel" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Style="{StaticResource Segmented}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="FuelLiters" Style="{StaticResource Segment}" GroupName="Fuel" Content="Liters" Checked="Units_Changed"/>
                                        <RadioButton x:Name="FuelGallons" Style="{StaticResource Segment}" GroupName="Fuel" Content="Gallons" Checked="Units_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Temperature" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Style="{StaticResource Segmented}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TempC" Style="{StaticResource Segment}" GroupName="Temp" Content="°C" Checked="Units_Changed"/>
                                        <RadioButton x:Name="TempF" Style="{StaticResource Segment}" GroupName="Temp" Content="°F" Checked="Units_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Behavior" Style="{StaticResource T.Title}"/>
                            <TextBlock Text="How the app opens and when the dashboard runs." Style="{StaticResource T.Caption}" Margin="0,4,0,18"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Open on" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="The page the app shows when it starts." Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Segmented}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="OpenDashboards" Style="{StaticResource Segment}" GroupName="StartPage" Content="Dashboards" Checked="StartPage_Changed"/>
                                        <RadioButton x:Name="OpenDevices" Style="{StaticResource Segment}" GroupName="StartPage" Content="Devices" Checked="StartPage_Changed"/>
                                        <RadioButton x:Name="OpenSettings" Style="{StaticResource Segment}" GroupName="StartPage" Content="Settings" Checked="StartPage_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Minimize to the system tray" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="Minimizing tucks the window into the notification area instead of the taskbar. The dashboard keeps running either way." Style="{StaticResource T.Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="TrayToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="Tray_Click" Unchecked="Tray_Click"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Switch dashboards by track type" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="Use each dashboard's track-type assignments. When off, the default dashboard is always shown." Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoSwitchToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="AutoSwitch_Click" Unchecked="AutoSwitch_Click"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Start with Windows" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="Run the dashboard quietly in the background when you sign in." Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="Startup_Click" Unchecked="Startup_Click"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="Diagnostic logs" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="Keep small logs of blind-spot calls and of which light layers lit which LEDs, to look into an odd light after a race. No names or account details are recorded." TextWrapping="Wrap" Style="{StaticResource T.Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Content="Open logs" Margin="0,0,12,0" VerticalAlignment="Center" Click="OpenLogs_Click"/>
                                <CheckBox x:Name="DiagnosticsToggle" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="Diagnostics_Click" Unchecked="Diagnostics_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource T.Title}"/>
                            <Grid Style="{StaticResource Row}" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Settings file" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsPathText" Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                           Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="Show in folder" Margin="12,0,0,0" Click="OpenSettingsFolder_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>