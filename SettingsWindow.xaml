<Window x:Class="DV5Direct.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DV5Direct" Width="1160" Height="760" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#080E19"
        FontFamily="Segoe UI" Foreground="#F3F7FC">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#42D3DC"/>
        <SolidColorBrush x:Key="Muted" Color="#8B9EB5"/>
        <SolidColorBrush x:Key="Card" Color="#101B2B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A3B50"/>
        <DataTemplate x:Key="ComboTextTemplate"><TextBlock Text="{Binding}" Foreground="#111111" FontWeight="SemiBold"/></DataTemplate>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#173344"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#236A83"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="14,10"/><Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#111111"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#B8C1CC"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="Height" Value="34"/><Setter Property="ItemTemplate" Value="{StaticResource ComboTextTemplate}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#111111"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Padding" Value="10,7"/>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#236A83"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1E96A3"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F3F7FC"/><Setter Property="Background" Value="#1D2B3E"/><Setter Property="BorderBrush" Value="#3A526D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,5"/><Setter Property="Height" Value="34"/><Setter Property="CaretBrush" Value="White"/><Setter Property="SelectionBrush" Value="#1E96A3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DAE5F1"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,26,8"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#000000"/></Setter.Value></Setter></Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#203246" BorderThickness="0,0,0,1">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0C1828"/><GradientStop Color="#07101C" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,11,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2AC6CF"/><GradientStop Color="#376BDD" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="D5" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="DV5 DIRECT" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="iRacing display control" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                    <Border x:Name="StatusBadge" Background="#102E29" CornerRadius="10" Padding="10,5" Margin="24,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="●  SETTINGS READY" Foreground="#5CDC9B" FontSize="10" FontWeight="Bold"/></Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartDashboardButton" Content="▶  START DASHBOARD" Background="#1E96A3" Margin="0,0,10,0" Click="StartDashboard_Click"/>
                    <Button Content="■  STOP" Click="StopDashboard_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#17283B" BorderThickness="0,0,1,0">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0B1523"/><GradientStop Color="#080F1B" Offset="1"/></LinearGradientBrush></Border.Background>
                <StackPanel Margin="14,18">
                    <TextBlock Text="WORKSPACE" Foreground="#5B738D" FontSize="10" FontWeight="Bold" Margin="7,0,0,9"/>
                    <Button Style="{StaticResource NavButton}" Content="▦   DASHBOARDS" Click="ShowGallery_Click"/>
                    <TextBlock Text="MY DASHBOARDS" Foreground="#5B738D" FontSize="10" FontWeight="Bold" Margin="7,17,0,7"/>
                    <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Content="◈   VELOCITY" Click="ShowDashboard_Click"/>
                    <TextBlock Text="More layouts can be added without replacing this app." TextWrapping="Wrap" Foreground="#647B94" Margin="8,14,12,0" LineHeight="18"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Background="#080E19">
                <ScrollViewer x:Name="GalleryPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26,20,26,30">
                        <TextBlock Text="DASHBOARDS" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="Choose the default dashboard used when no automatic assignment matches." Foreground="{StaticResource Muted}" Margin="2,4,0,18"/>
                        <WrapPanel x:Name="DashboardCards"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="EditorPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="26,20,26,30">
                        <TextBlock x:Name="EditorTitle" Text="VELOCITY" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="Settings saved here apply only to this dashboard." Foreground="{StaticResource Muted}" Margin="2,4,0,12"/>
                        <Separator Background="#253A51" Margin="0,0,0,16"/>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="AUTOMATIC ASSIGNMENT"/><TextBlock Foreground="{StaticResource Muted}" Text="Use this dashboard for any selected iRacing discipline." Margin="0,0,0,12"/>
                        <Border Style="{StaticResource CardStyle}"><WrapPanel><CheckBox x:Name="OvalCheck" Content="Oval"/><CheckBox x:Name="RoadCheck" Content="Road"/><CheckBox x:Name="DirtOvalCheck" Content="Dirt Oval"/><CheckBox x:Name="DirtRoadCheck" Content="Dirt Road"/></WrapPanel></Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="DASHBOARD APPEARANCE"/><TextBlock Foreground="{StaticResource Muted}" Text="Replace the dashboard accent color while preserving contrast." Margin="0,0,0,12"/>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Orientation="Horizontal"><Border x:Name="AccentSwatch" Width="42" Height="42" CornerRadius="10" Margin="0,0,13,0"/><Button x:Name="AccentButton" Content="#009BD2" Click="AccentButton_Click"/></StackPanel></Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="CENTER 8 LEDS"/><TextBlock Foreground="{StaticResource Muted}" Text="Configure the upper RPM and shift-light bank." Margin="0,0,0,12"/>
                        <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,22,0"><TextBlock Style="{StaticResource FieldLabel}" Text="PATTERN"/><ComboBox x:Name="CenterPattern"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,22,0"><TextBlock Style="{StaticResource FieldLabel}" Text="COLOR PROFILE"/><ComboBox x:Name="CenterProfile"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,22,0"><TextBlock Style="{StaticResource FieldLabel}" Text="BRIGHTNESS"/><Grid><Slider x:Name="CenterBrightness" Minimum="0" Maximum="100" VerticalAlignment="Center"/><TextBlock x:Name="CenterBrightnessValue" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1D2B3E" Padding="7,3"/></Grid></StackPanel>
                            <Button Grid.Column="3" Content="CUSTOM COLORS" VerticalAlignment="Bottom" Click="CenterColors_Click"/>
                        </Grid></Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="LEFT LEDS"/><TextBlock Foreground="{StaticResource Muted}" Text="Choose how this bank is used and how it looks." Margin="0,0,0,12"/>
                        <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,22,0"><TextBlock Style="{StaticResource FieldLabel}" Text="FUNCTION"/><ComboBox x:Name="LeftFunction"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,22,0"><TextBlock Style="{StaticResource FieldLabel}" Text="COLOR PROFILE"/><ComboBox x:Name="LeftProfile"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,22,0"><TextBlock Style="{StaticResource FieldLabel}" Text="BRIGHTNESS"/><Grid><Slider x:Name="LeftBrightness" Minimum="0" Maximum="100"/><TextBlock x:Name="LeftBrightnessValue" HorizontalAlignment="Right" Background="#1D2B3E" Padding="7,3"/></Grid></StackPanel><Button Grid.Column="3" Content="CUSTOM COLORS" VerticalAlignment="Bottom" Click="LeftColors_Click"/>
                        </Grid></Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="RIGHT LEDS"/><TextBlock Foreground="{StaticResource Muted}" Text="Choose how this bank is used and how it looks." Margin="0,0,0,12"/>
                        <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,22,0"><TextBlock Style="{StaticResource FieldLabel}" Text="FUNCTION"/><ComboBox x:Name="RightFunction"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,22,0"><TextBlock Style="{StaticResource FieldLabel}" Text="COLOR PROFILE"/><ComboBox x:Name="RightProfile"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,22,0"><TextBlock Style="{StaticResource FieldLabel}" Text="BRIGHTNESS"/><Grid><Slider x:Name="RightBrightness" Minimum="0" Maximum="100"/><TextBlock x:Name="RightBrightnessValue" HorizontalAlignment="Right" Background="#1D2B3E" Padding="7,3"/></Grid></StackPanel><Button Grid.Column="3" Content="CUSTOM COLORS" VerticalAlignment="Bottom" Click="RightColors_Click"/>
                        </Grid></Border>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="ALERTS &amp; FLAGS"/><TextBlock Foreground="{StaticResource Muted}" Text="Set the default timing used by dashboard flag alerts." Margin="0,0,0,12"/>
                        <Border Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Style="{StaticResource FieldLabel}" Text="BLINK COUNT"/><TextBox x:Name="BlinkCountBox"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,24,0"><TextBlock Style="{StaticResource FieldLabel}" Text="BLINK LENGTH (MS)"/><TextBox x:Name="BlinkLengthBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="HOLD AFTER BLINKING (MS)"/><TextBox x:Name="HoldBox"/></StackPanel></Grid></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
